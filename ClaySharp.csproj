<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <!-- https://github.com/nicbarker/clay/pull/642 -->
    <DefineConstants>$(DefineConstants);CLAY_INCLUDE_LETTER_SPACING_FIX</DefineConstants>

    <!-- https://github.com/nicbarker/clay/pull/568 -->
    <DefineConstants>$(DefineConstants);CLAY_INCLUDE_SCISSOR_END_FIX</DefineConstants>

    <!-- https://github.com/nicbarker/clay/pull/553 -->
    <DefineConstants>$(DefineConstants);CLAY_INCLUDE_SCROLL_JUMP_FIX</DefineConstants>
    
    <!--
    TODO:
    
    https://github.com/nicbarker/clay/pull/598 - easy pickings
    https://github.com/nicbarker/clay/pull/311 - should be done in the layout, not the renderer!
    https://github.com/nicbarker/clay/pull/599 - a bit more substantial
    https://github.com/nicbarker/clay/pull/485 - needs work
    -->
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Primitives" Version="10.0.11" />
  </ItemGroup>

  <!-- Keep the verification harness (a separate project) out of the library compile. -->
  <ItemGroup>
    <Compile Remove="harness\**\*.cs" />
    <None Remove="harness\**\*" />
    <Compile Remove="renderer\**" />
    <None Remove="renderer\**" />
    <Compile Remove="clay\**" />
    <None Remove="clay\**" />
    <Compile Remove="examples\**" />
    <None Remove="examples\**" />
    <Compile Remove="plugins\**" />
    <None Remove="plugins\**" />
  </ItemGroup>
  <ItemGroup>
    <EmbeddedResource Remove="renderer\**" />
    <EmbeddedResource Remove="clay\**" />
    <EmbeddedResource Remove="plugins\**" />
  </ItemGroup>

</Project>

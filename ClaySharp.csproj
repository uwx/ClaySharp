<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Primitives" Version="10.0.11" />
  </ItemGroup>

  <!-- Keep the verification harness (a separate project) out of the library compile. -->
  <ItemGroup>
    <Compile Remove="harness\**\*.cs" />
    <None Remove="harness\**\*" />
    <Compile Remove="renderer\**" />
    <None Remove="renderer\**" />
    <Compile Remove="clay\**" />
    <None Remove="clay\**" />
    <Compile Remove="examples\**" />
    <None Remove="examples\**" />
  </ItemGroup>
  <ItemGroup>
    <EmbeddedResource Remove="renderer\**" />
    <EmbeddedResource Remove="clay\**" />
  </ItemGroup>

</Project>

<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\plugins\ClaySharp.Plugin.TextInput.FNA\ClaySharp.Plugin.TextInput.FNA.csproj" />
    <ProjectReference Include="..\..\plugins\ClaySharp.Plugin.TextInput\ClaySharp.Plugin.TextInput.csproj" />
    <ProjectReference Include="..\..\renderer\nvg\ClaySharp.Renderer.NvgSharp.csproj" />
  </ItemGroup>

  <!-- Reuse the shared clay-video-demo layout (font/image agnostic). -->
  <ItemGroup>
    <Compile Include="..\SDL3SimpleDemo\ClayVideoDemo.cs" Link="ClayVideoDemo.cs" />
  </ItemGroup>

  <!-- Copy the sample resources (font + image) next to the built output. -->
  <ItemGroup>
    <None Include="..\..\clay\examples\SDL3-simple-demo\resources\**"
          Link="resources\%(RecursiveDir)%(Filename)%(Extension)"
          CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\FNASimpleDemo\FAudio.dll" Link="FAudio.dll" CopyToOutputDirectory="Always" />
    <None Include="..\FNASimpleDemo\FNA3D.dll" Link="FNA3D.dll" CopyToOutputDirectory="Always" />
    <None Include="..\FNASimpleDemo\libtheorafile.dll" Link="libtheorafile.dll" CopyToOutputDirectory="Always" />
    <None Include="..\FNASimpleDemo\SDL3.dll" Link="SDL3.dll" CopyToOutputDirectory="Always" />
  </ItemGroup>

</Project>

<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\renderer\sdl3\ClaySharp.Renderer.SDL3.csproj" />
    <ProjectReference Include="..\..\plugins\ClaySharp.Plugin.TextInput\ClaySharp.Plugin.TextInput.csproj" />
    <ProjectReference Include="..\..\plugins\ClaySharp.Plugin.TextInput.SDL3\ClaySharp.Plugin.TextInput.SDL3.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="SDL3-CS.Windows.Image" Version="3.4.4.10" />
  </ItemGroup>

  <!-- Copy the sample resources (font + image) next to the built output. -->
  <ItemGroup>
    <None Include="..\..\clay\examples\SDL3-simple-demo\resources\**"
          Link="resources\%(RecursiveDir)%(Filename)%(Extension)"
          CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>

<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\renderer\fna\ClaySharp.Renderer.FNA.csproj" />
  </ItemGroup>

  <!-- Reuse the shared clay-video-demo layout (font/image agnostic). -->
  <ItemGroup>
    <Compile Include="..\SDL3SimpleDemo\ClayVideoDemo.cs" Link="ClayVideoDemo.cs" />
  </ItemGroup>

  <!-- Copy the sample resources (font + image) next to the built output. -->
  <ItemGroup>
    <None Include="..\..\clay\examples\SDL3-simple-demo\resources\**"
          Link="resources\%(RecursiveDir)%(Filename)%(Extension)"
          CopyToOutputDirectory="PreserveNewest" />
    <None Update="FAudio.dll">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </None>
    <None Update="FNA3D.dll">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </None>
    <None Update="libtheorafile.dll">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </None>
    <None Update="SDL3.dll">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </None>
  </ItemGroup>

</Project>
